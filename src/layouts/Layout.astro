---
import Analytics from '@vercel/analytics/astro';
import Intro from '../components/Intro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// In sviluppo l'intro riparte a ogni refresh: è l'unico modo per lavorarci
// sopra senza svuotare lo storage a mano. In produzione resta una volta per
// sessione, con `?intro` per forzarla quando la vuoi mostrare a qualcuno.
const replayIntro = import.meta.env.DEV;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d0ddd7" />
    <!-- Compare in un istante preciso della sceneggiatura: non deve caricarsi lì. -->
    <link rel="preload" as="image" href="/simone-preview.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>

    <!--
      Deve girare prima del primo paint, quindi resta inline e non bundled.
      È questo script a decidere se l'intro va in scena: il CSS la tiene
      nascosta finché non compare la classe. Senza JavaScript si atterra
      direttamente sul sito.
    -->
    <script is:inline define:vars={{ replayIntro }}>
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) return;

        const forced = replayIntro || new URLSearchParams(location.search).has('intro');
        let seen = false;
        try {
          seen = !!sessionStorage.getItem('intro-seen');
        } catch {
          // Storage negato: l'intro va in scena comunque.
        }

        if (forced || !seen) {
          document.documentElement.classList.add('intro-active');
        }
      })();
    </script>
  </head>

  <body>
    <Intro client:load />
    <slot />
    <Analytics />

    <script>
      // Le sezioni entrano allo scroll. L'opacità la toglie lo script, non il
      // CSS: se questo file non arriva mai, il contenuto resta visibile invece
      // di sparire per sempre.
      const targets = document.querySelectorAll<HTMLElement>('[data-appear]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduced && targets.length) {
        targets.forEach((element) => element.classList.add('is-armed'));

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.remove('is-armed');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px' },
        );

        targets.forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
