---
/**
 * Interruttore chiaro/scuro. Nessuna idratazione: è un bottone e otto righe
 * di script. La scelta esplicita vince sul sistema e viene ricordata.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="rounded-full border border-line p-2 text-dim transition hover:border-fuchsia hover:text-fuchsia"
  aria-label="Cambia tema"
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="hidden dark:block">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"
      ></path>
    </g>
  </svg>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="block dark:hidden">
    <path
      d="M20 14.2A8.2 8.2 0 019.8 4a8.4 8.4 0 102.4 16.4 8.4 8.4 0 007.8-6.2z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = !root.classList.contains('dark');
    root.classList.toggle('dark', dark);
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      // Storage negato: il tema vale per questa pagina e basta.
    }
    // Il ritratto ASCII dipinge su canvas e non vede il CSS cambiare da solo.
    window.dispatchEvent(new CustomEvent('themechange'));
  });
</script>
