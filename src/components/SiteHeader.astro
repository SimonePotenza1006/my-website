---
const links = [
  { label: 'Percorso', href: '#percorso' },
  { label: 'Lavori', href: '#lavori' },
  { label: 'Come lavoro', href: '#metodo' },
  { label: 'Domande', href: '#domande' },
];
---

<header
  class="fixed inset-x-0 top-0 z-30 border-b border-mist/70 bg-paper/85 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4 md:px-12">
    <a href="#top" class="font-mono text-xs tracking-[0.2em] text-earth uppercase">
      Simone Potenza
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Sezioni">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-mono text-xs tracking-[0.16em] text-olive uppercase underline-offset-4 transition hover:underline"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contatti"
      class="rounded-full border border-earth px-4 py-2 font-mono text-xs tracking-[0.16em] text-earth uppercase transition hover:bg-earth hover:text-paper"
    >
      Parliamone
    </a>
  </div>
</header>
