---
const links = [
  { label: 'Percorso', href: '#percorso' },
  { label: 'Lavori', href: '#lavori' },
  { label: 'Come lavoro', href: '#metodo' },
  { label: 'Servizi', href: '#servizi' },
  { label: 'Domande', href: '#domande' },
];
---

<!--
  La barra sta sotto il nome, incassata fra due righe sottili. È sticky, non
  fixed: parte da lì e si aggancia in cima solo quando la si supera, così
  resta raggiungibile senza doverla duplicare.
-->
<nav
  class="sticky top-0 z-30 -mx-6 border-y border-line bg-canvas/90 backdrop-blur md:-mx-12"
  aria-label="Sezioni"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3 md:px-12"
  >
    <div class="flex items-center gap-6 overflow-x-auto md:gap-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="shrink-0 font-mono text-[11px] tracking-[0.18em] text-muted uppercase underline-offset-4 transition hover:text-fg hover:underline"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="#contatti"
      class="shrink-0 rounded-full border border-fg px-4 py-1.5 font-mono text-[11px] tracking-[0.18em] text-fg uppercase transition hover:bg-fg hover:text-canvas"
    >
      Parliamone
    </a>
  </div>
</nav>
