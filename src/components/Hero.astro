---
interface Props {
  photo: { src: string; width: number; height: number };
}

const { photo } = Astro.props;
---

<!--
  Il blocco della foto sta sotto la barra e occupa il resto della schermata:
  ritaglio grande a destra, appoggiato al bordo inferiore, testo a sinistra.
-->
<section
  class="mx-auto grid w-full max-w-6xl items-end gap-10 pt-10 md:min-h-[58svh] md:grid-cols-[1fr_1.05fr] md:gap-14 md:pt-6"
>
  <div class="reveal flex flex-col gap-8 pb-8 md:pb-20" style="--reveal-delay: 240ms">
    <p class="max-w-md font-display text-[clamp(1.5rem,3vw,2.4rem)] leading-[1.08] font-bold tracking-tight text-balance">
      Front end, back end, e tutto quello che sta in mezzo.
    </p>

    <p class="max-w-sm leading-relaxed text-muted">
      Costruisco prodotti interi: l’interfaccia con cui la gente ci parla e il sistema che la
      tiene in piedi. Di solito la parte difficile è farli combaciare.
    </p>

    <div class="flex flex-wrap items-center gap-5">
      <a
        href="#contatti"
        class="rounded-full bg-fg px-6 py-3 font-medium text-canvas transition hover:bg-muted"
      >
        Parliamone
      </a>
      <a
        href="#lavori"
        class="font-mono text-xs tracking-[0.18em] text-muted uppercase underline-offset-4 transition hover:underline"
      >
        Vedi i lavori
      </a>
    </div>
  </div>

  <div class="reveal relative flex justify-center md:justify-end" style="--reveal-delay: 320ms">
    <img
      src={photo.src}
      width={photo.width}
      height={photo.height}
      alt="Simone Potenza"
      fetchpriority="high"
      class="w-[min(86vw,520px)] [mask-image:linear-gradient(to_bottom,black_88%,transparent_100%)]"
    />
  </div>
</section>
