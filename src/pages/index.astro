---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Method from '../components/Method.astro';
import Faq from '../components/Faq.astro';
import WorkGrid from '../components/WorkGrid';
import { projects, tags } from '../data/work';

// Il ritaglio è già esportato alla misura che serve. Passando per `import` di
// src/assets, Astro emetteva anche il master PNG da 1,1 MB pur non servendolo.
const PHOTO = { src: '/simone-hero.webp', width: 840, height: 941 };
---

<Layout
  title="Simone Potenza — Full stack developer"
  description="Front end, back end e tutto quello che sta in mezzo. Portfolio di Simone Potenza, full stack developer: percorso, lavori e come lavoro."
>
  <span id="top"></span>

  <main class="px-6 md:px-12">
    <!--
      Il nome apre la pagina a piena larghezza, la barra si incassa subito
      sotto, la foto occupa il resto della schermata.

      La barra è figlia diretta di <main>: un elemento sticky si aggancia solo
      dentro il proprio contenitore, quindi chiuderla in un blocco alto quanto
      lei la renderebbe inutile appena si scorre.
    -->
    <div class="reveal mx-auto w-full max-w-6xl pt-8 md:pt-10" style="--reveal-delay: 80ms">
      <p class="mb-4 font-mono text-[11px] tracking-[0.24em] text-olive uppercase">
        Full stack developer
      </p>
      <h1
        class="font-display text-[clamp(2.6rem,17.5vw,13rem)] leading-[0.82] font-extrabold tracking-[-0.045em]"
      >
        Simone<br />Potenza
      </h1>
    </div>

    <SiteHeader />

    <Hero photo={PHOTO} />

    <Timeline />

    <section id="lavori" class="mx-auto max-w-6xl border-t border-mist py-20 md:py-28">
      <h2 class="font-mono text-xs tracking-[0.24em] text-olive uppercase" data-appear>I lavori</h2>

      <p
        class="mt-6 max-w-2xl font-display text-[clamp(1.8rem,3.6vw,3rem)] leading-[1.05] font-bold tracking-tight text-balance"
        data-appear
        style="--appear-delay: 80ms"
      >
        Prodotti interi, non pezzi di prodotto.
      </p>

      <div class="mt-12" data-appear style="--appear-delay: 160ms">
        <WorkGrid client:visible projects={projects} tags={tags} />
      </div>
    </section>

    <Method />

    <Faq />

    <section id="contatti" class="mx-auto max-w-6xl border-t border-mist py-20 md:py-28">
      <h2 class="font-mono text-xs tracking-[0.24em] text-olive uppercase" data-appear>Contatti</h2>

      <p
        class="mt-8 max-w-3xl font-display text-[clamp(2rem,4.6vw,3.8rem)] leading-[1.02] font-extrabold tracking-tight text-balance"
        data-appear
        style="--appear-delay: 80ms"
      >
        Se ti serve qualcuno che ti costruisca la cosa intera, scrivimi.
      </p>

      <div
        class="mt-12 grid gap-px overflow-hidden border border-mist bg-mist sm:grid-cols-3"
        data-appear
        style="--appear-delay: 160ms"
      >
        <a
          href="mailto:simonepotenzatr@gmail.com"
          class="flex flex-col gap-2 bg-paper p-7 transition hover:bg-mist/30"
        >
          <span class="font-mono text-[11px] tracking-[0.2em] text-olive uppercase">Email</span>
          <span class="text-lg break-all text-earth">simonepotenzatr@gmail.com</span>
        </a>
        <a
          href="https://github.com/SimonePotenza1006"
          target="_blank"
          rel="noreferrer"
          class="flex flex-col gap-2 bg-paper p-7 transition hover:bg-mist/30"
        >
          <span class="font-mono text-[11px] tracking-[0.2em] text-olive uppercase">GitHub</span>
          <span class="text-lg text-earth">SimonePotenza1006 ↗</span>
        </a>
        <!-- TODO: incolla l'URL del tuo profilo LinkedIn. -->
        <div class="flex flex-col gap-2 bg-paper p-7">
          <span class="font-mono text-[11px] tracking-[0.2em] text-olive uppercase">LinkedIn</span>
          <span class="text-lg text-olive">Da aggiungere</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-mist px-6 py-10 md:px-12">
    <p class="mx-auto max-w-6xl font-mono text-xs tracking-wider text-olive">
      Costruito con Astro. Statistiche di visita anonime, nessun cookie.
    </p>
  </footer>
</Layout>
